# Environment variables for running tests against docker-compose services

# API Configuration
API_BASE_URL=http://localhost:8080

# AWS Local Configuration
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_DEFAULT_REGION=us-west-2
AWS_ENDPOINT_URL=http://localhost:8011
DYNAMODB_ENDPOINT_URL=http://localhost:8011

# DynamoDB Tables
ADDRESS_WATCHLIST_TABLE=AddressWatchlist-local
SUSPICIOUS_TRANSACTIONS_TABLE=SuspiciousTransactions-local
INVESTIGATION_NOTES_TABLE=InvestigationNotes-local

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# Test Environment
ENVIRONMENT=testing
LOG_LEVEL=DEBUG

# Mock Provider
BLOCKCHAIN_PROVIDER=mock
MOCK_DATA_PATH=./test-data/mock-blockchain