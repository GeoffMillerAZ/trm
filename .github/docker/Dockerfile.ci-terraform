# CI Container for Terraform Operations
# Optimized for infrastructure testing and deployment

FROM alpine:3.18 AS base

# Install required packages
RUN apk add --no-cache \
    curl \
    git \
    bash \
    jq \
    aws-cli \
    python3 \
    py3-pip

# Install specific Terraform version
ARG TERRAFORM_VERSION=1.9.5
RUN curl -Lo terraform.zip https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_linux_amd64.zip && \
    unzip terraform.zip && \
    mv terraform /usr/local/bin/ && \
    rm terraform.zip && \
    terraform version

# Install OPA for policy validation
ARG OPA_VERSION=0.68.0
RUN curl -Lo /usr/local/bin/opa https://github.com/open-policy-agent/opa/releases/download/v${OPA_VERSION}/opa_linux_amd64_static && \
    chmod +x /usr/local/bin/opa && \
    opa version

# Install TFLint
ARG TFLINT_VERSION=0.48.0
RUN curl -Lo tflint.zip https://github.com/terraform-linters/tflint/releases/download/v${TFLINT_VERSION}/tflint_linux_amd64.zip && \
    unzip tflint.zip && \
    mv tflint /usr/local/bin/ && \
    rm tflint.zip

# Create workspace
WORKDIR /workspace

# Set up Terraform plugin cache
ENV TF_PLUGIN_CACHE_DIR=/terraform-cache
RUN mkdir -p ${TF_PLUGIN_CACHE_DIR}

# Default command
CMD ["/bin/bash"]