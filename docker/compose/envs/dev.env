# Dev mode - Uses AWS development environment
# No local services needed - connects directly to deployed API
ENVIRONMENT=dev
API_HOST="https://api.trm.geoffmiller.cloud"
API_VERSION="v1"
API_TIMEOUT="30"

# Test Configuration
CONCURRENT_REQUESTS="5"
RETRY_COUNT="3"
RETRY_DELAY="1"

# Logging
LOG_LEVEL="INFO"
VERBOSE_OUTPUT="true"