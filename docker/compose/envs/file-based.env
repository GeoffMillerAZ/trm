# File-based mode - Uses filesystem for all services
ENVIRONMENT=file_based
USE_FILE_BASED_INFRASTRUCTURE=true
USE_MOCK_BLOCKCHAIN=true
REDIS_URL=file
WORKSPACE_BASE_PATH=/app/workspace
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60
TRACING_BACKEND=silent
TRACING_SERVICE_NAME=trm-blockexplorer-file-based
SECRETS_BACKEND=environment
API_TITLE="TRM Block Explorer API (File-Based Mode)"
DEBUG=true
LOG_LEVEL=DEBUG
LOG_FORMAT=text