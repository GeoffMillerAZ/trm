# Mock mode - All in-memory mocks, no external services
ENVIRONMENT=local
USE_FILE_BASED_INFRASTRUCTURE=false
USE_MOCK_BLOCKCHAIN=true
REDIS_URL=mock
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60
TRACING_BACKEND=silent
TRACING_SERVICE_NAME=trm-blockexplorer-mock
SECRETS_BACKEND=environment
API_TITLE="TRM Block Explorer API (Mock Mode)"
DEBUG=true
LOG_LEVEL=DEBUG
LOG_FORMAT=text