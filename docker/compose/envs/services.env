# Services mode - Uses real Docker services (Redis, DynamoDB) with mock blockchain
ENVIRONMENT=local
USE_FILE_BASED_INFRASTRUCTURE=false
USE_MOCK_BLOCKCHAIN=true
REDIS_URL=redis://redis:6379
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
DYNAMODB_ENDPOINT=http://dynamodb:8000
DYNAMODB_TABLE_NAME=trm-blockexplorer
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
TRACING_BACKEND=console
TRACING_SERVICE_NAME=trm-blockexplorer-services
SECRETS_BACKEND=environment
API_TITLE="TRM Block Explorer API (Services Mode)"
DEBUG=true
LOG_LEVEL=DEBUG
LOG_FORMAT=json