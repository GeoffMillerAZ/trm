# WAN mode - Uses real services with real Infura API
# Requires INFURA_API_KEY to be set
ENVIRONMENT=local
USE_FILE_BASED_INFRASTRUCTURE=false
USE_MOCK_BLOCKCHAIN=false
CONFIG_FILE=configs/local-wan.yaml
REDIS_URL=redis://redis:6379
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
DYNAMODB_ENDPOINT=http://dynamodb:8000
DYNAMODB_TABLE_NAME=trm-blockexplorer-wan
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
INFURA_NETWORK=mainnet
TRACING_BACKEND=console
TRACING_SERVICE_NAME=trm-blockexplorer-wan
SECRETS_BACKEND=environment
API_TITLE="TRM Block Explorer API (WAN Mode)"
DEBUG=true
LOG_LEVEL=DEBUG
LOG_FORMAT=json