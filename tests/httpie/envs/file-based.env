# File-based testing environment
# For testing against local file implementations instead of external services
# This uses file_repository.py, file_cache.py, etc. for predictable test data

# API Configuration
API_HOST="http://localhost:8000"
API_TIMEOUT="30"
API_VERSION="v1"

# Test Addresses - These should match addresses in your test data files
# You can add test data files to workspace/ directory for these addresses
ETH2_DEPOSIT_ADDRESS="0x00000000219ab540356cBB839Cbe05303d7705Fa"
VITALIK_ADDRESS="0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045"
REGULAR_USER_ADDRESS="0x742d35Cc6634C0532925a3b844Bc9e7595ED6fF5"
EMPTY_WALLET_ADDRESS="0x0000000000000000000000000000000000000000"
DUST_AMOUNT_ADDRESS="0x1234567890123456789012345678901234567890"
WHALE_ADDRESS="0xDEADBEEFDEADBEEFDEADBEEFDEADBEEFDEADBEEF"

# File-based test addresses for known test scenarios
TEST_ADDRESS_1="0x1111111111111111111111111111111111111111"
TEST_ADDRESS_2="0x2222222222222222222222222222222222222222"
TEST_ADDRESS_3="0x3333333333333333333333333333333333333333"

# Expected Values - These match the existing workspace test data files
# These values are from the actual test data in workspace/db/balances/
ETH2_DEPOSIT_EXPECTED="50000000"    # 50M ETH (from existing test data)
VITALIK_EXPECTED="325159.5"         # ~325K ETH (from existing test data)
REGULAR_USER_EXPECTED="10"          # 10 ETH (no test data yet - can be added)
EMPTY_WALLET_EXPECTED="0"           # 0 ETH (should always be empty)
DUST_AMOUNT_EXPECTED="6.833366"     # ~6.83 ETH (from existing test data)
WHALE_EXPECTED="999999.999999999999999999"  # ~1M ETH (from existing test data)

# Test-specific expected values
TEST_ADDRESS_1_EXPECTED="50"        # 50 ETH in test data
TEST_ADDRESS_2_EXPECTED="25"        # 25 ETH in test data
TEST_ADDRESS_3_EXPECTED="100"       # 100 ETH in test data

# Test Configuration - Can be aggressive since it's file-based
CONCURRENT_REQUESTS="20"            # High concurrency for file-based testing
RETRY_COUNT="1"                     # Don't need retries for file-based
RETRY_DELAY="0.1"                   # Very short delay

# Logging - Verbose for debugging file-based behavior
LOG_LEVEL="DEBUG"
VERBOSE_OUTPUT="true"

# File-based Environment Variables
# These should match the docker-compose.test.yml configuration
ENVIRONMENT="file_based"
USE_MOCK_BLOCKCHAIN="true"
USE_FILE_BASED_INFRASTRUCTURE="true"
WORKSPACE_BASE_PATH="./workspace"
INFURA_API_KEY="dummy_key_for_file_based_testing"

# Cache Configuration
CACHE_ENABLED="true"
CACHE_TTL_SECONDS="60"

# Tracing Configuration
TRACING_BACKEND="silent"
TRACING_SERVICE_NAME="trm-blockexplorer-test"

# Secrets Backend
SECRETS_BACKEND="environment"

# API Configuration
API_TITLE="TRM Block Explorer API (File-based Test Mode)"
DEBUG="true"

# CORS for testing tools
ENABLE_CORS="true"
CORS_ORIGINS='["*"]'

# Logging Configuration
LOG_FORMAT="text"
ENABLE_CLOUDWATCH_LOGGING="false"
