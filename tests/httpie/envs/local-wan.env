# Local development environment with WAN access
# For testing against locally running API connected to live Ethereum blockchain via Infura
#
# IMPORTANT: To use this environment, start your local service with:
#   export INFURA_API_KEY=your_actual_api_key
#   export USE_FILE_BASED_INFRASTRUCTURE=false
#   # Then start your service

# API Configuration
API_HOST="http://localhost:8000"
API_TIMEOUT="60"
API_VERSION="v1"

# Test Addresses - Real Ethereum addresses for testing
ETH2_DEPOSIT_ADDRESS="0x00000000219ab540356cBB839Cbe05303d7705Fa"
VITALIK_BUTERIN_ADDRESS="0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045"

# Block Hashes for testing - using real Ethereum block hashes
VALID_BLOCK_HASH="0x88e96d4537bea4d9c05d12549907b32561d3bf31f45aae734cdc119f13406cb6"
NON_EXISTENT_BLOCK_HASH="0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef"
INVALID_BLOCK_HASH="0x12345"

# Test Configuration
CONCURRENT_REQUESTS="10"
RETRY_COUNT="3"
RETRY_DELAY="1"

# Logging
LOG_LEVEL="INFO"
VERBOSE_OUTPUT="false"
