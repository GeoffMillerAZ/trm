# Production environment
# For testing against production API (use with caution)

# API Configuration
API_HOST="https://api.trm.geoffmiller.cloud"
API_TIMEOUT="30"
API_VERSION="v1"

# Test Addresses - Conservative set for production testing
ETH2_DEPOSIT_ADDRESS="0x00000000219ab540356cBB839Cbe05303d7705Fa"
VITALIK_ADDRESS="0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045"
REGULAR_USER_ADDRESS="0x742d35Cc6634C0532925a3b844Bc9e7595ED6fF5"
EMPTY_WALLET_ADDRESS="0x0000000000000000000000000000000000000000"

# Disable potentially disruptive test addresses in production
DUST_AMOUNT_ADDRESS=""
WHALE_ADDRESS=""

# Expected Balance Ranges (for validation - these are live values)
ETH2_DEPOSIT_EXPECTED="36000000"  # ~36M+ ETH expected (live data)
VITALIK_EXPECTED="5234"           # ~5234 ETH expected (live data)
REGULAR_USER_EXPECTED="1.5"      # ~1.5 ETH expected (live data)
EMPTY_WALLET_EXPECTED="0"        # 0 ETH expected

# Test Configuration - Conservative for production
CONCURRENT_REQUESTS="2"          # Very low for production
RETRY_COUNT="2"
RETRY_DELAY="5"                  # Longer delay for production

# Logging
LOG_LEVEL="WARN"
VERBOSE_OUTPUT="false"
